# =============================================================
# Guardião Financeiro BR — variáveis de ambiente (EXEMPLO)
#
# Copie para `.env` e ajuste. O arquivo `.env` NUNCA é versionado.
# Todos os valores abaixo são placeholders seguros para uso LOCAL.
# No ambiente MVP (Azure) a configuração vem do Container Apps e os
# segredos do Azure Key Vault (ver docs/deployment-azure.md e ADR-006).
# =============================================================

# ---- Ambiente ----
# Valores aceitos: local | test | mvp   (mvp = único ambiente de nuvem)
APP_ENV=local
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# ---- Banco de dados local (Docker Compose) ----
POSTGRES_DB=guardiao
POSTGRES_USER=guardiao
# Defina uma senha local qualquer. Não reutilize senhas reais.
POSTGRES_PASSWORD=troque-esta-senha-local

# ---- Portas publicadas SOMENTE em 127.0.0.1 ----
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---- Autenticação DEV simulada ----
# Para usar a aplicação localmente sem Entra ID, defina true.
# Só é aceita com APP_ENV=local: em qualquer outro ambiente o backend
# recusa iniciar (ADR-006).
DEV_AUTH_ENABLED=false
# Perfis do usuário simulado: ADMIN, ANALYST, APPROVER, AUDITOR (separados por vírgula)
DEV_AUTH_ROLES=ADMIN

# ---- Storage de documentos (Sprint 2) ----
# local | azure_blob   (azure_blob é o storage oficial do MVP; local só para desenvolvimento)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local-storage

# ---- Limites de upload (Sprint 2) ----
MAX_UPLOAD_SIZE_MB=10

# ---- Integrações externas: DESATIVADAS por padrão ----
# Microsoft 365 / Graph (ingestão na Sprint 6). mock | graph
MAILBOX_INGESTION_MODE=mock
# Os valores abaixo ficam vazios localmente. Nunca coloque segredos aqui
# em arquivos versionados.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---- Deploy do MVP (NÃO preencha aqui) ----
# AZURE_SUBSCRIPTION_ID, AZURE_TENANT_ID, AZURE_REGION, RESOURCE_PREFIX, PROJECT_OWNER,
# M365_TENANT_DOMAIN, MVP_SHARED_MAILBOX_ALIAS e MVP_ADMIN_USER são informados na sessão
# do PowerShell de quem faz o deploy (docs/deployment-azure.md), nunca em arquivos.

# ---- Testes de integração do backend (opcional) ----
# Banco cujo nome contém "test" (será recriado a cada execução):
# TEST_DATABASE_URL=postgresql://guardiao:troque-esta-senha-local@localhost:5432/guardiao_test
