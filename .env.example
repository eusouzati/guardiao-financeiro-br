# =============================================================
# Guardião Financeiro BR — variáveis de ambiente (EXEMPLO)
#
# Copie para `.env` e ajuste. O arquivo `.env` NUNCA é versionado.
# Todos os valores abaixo são placeholders seguros para uso LOCAL.
# Em homologação/produção os segredos vêm do Azure Key Vault
# (ver docs/security.md e ADR-004).
# =============================================================

# ---- Ambiente ----
# Valores aceitos: local | test | homologation | production
APP_ENV=local

# ---- Banco de dados local (Docker Compose) ----
POSTGRES_DB=guardiao
POSTGRES_USER=guardiao
# Defina uma senha local qualquer. Não reutilize senhas reais.
POSTGRES_PASSWORD=troque-esta-senha-local
# Porta publicada SOMENTE em 127.0.0.1
POSTGRES_PORT=5432

# ---- Autenticação DEV simulada (Sprint 1/7) ----
# Só é aceita quando APP_ENV=local. O backend recusará iniciar com
# DEV_AUTH_ENABLED=true em qualquer outro ambiente (ver ADR-004).
DEV_AUTH_ENABLED=false

# ---- Storage de documentos ----
# local | azure_blob   (azure_blob somente a partir da Sprint 8)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local-storage

# ---- Limites de upload (Sprint 2) ----
MAX_UPLOAD_SIZE_MB=10

# ---- Integrações externas: DESATIVADAS por padrão ----
# Microsoft 365 / Graph (Sprint 6). mock | graph
MAILBOX_INGESTION_MODE=mock
# Os valores abaixo ficam vazios localmente. Nunca coloque segredos aqui
# em arquivos versionados.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
